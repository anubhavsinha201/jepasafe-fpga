# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
fpga_project/
venv/
.venv/

# Datasets and large artifacts
data/raw/*
data/processed/*
!data/**/.gitkeep
!data/README.md

# Dataset unzipped at the repo root (270 MB) — see DATASET_CANDIDATES in demopart.py
UCI-HAR Dataset/
UCI HAR Dataset/

# Model artifacts (keep the dirs, not the weights)
models/**/*.h5
models/**/*.keras
models/**/*.npy
models/**/*.pb
!models/**/.gitkeep
!models/README.md
# ...except the two trained checkpoints. They are ~400 KB each and without them
# nobody can regenerate the exact HLS project behind the published accuracy.
!models/checkpoints/cnnlstm_keras.keras
!models/checkpoints/cnnlstm_keras_64.keras

# hls4ml generated projects
hls/*
!hls/.gitkeep

# Simulation output
sim/*
!sim/.gitkeep
*.vcd
*.vvp
a.out

# Gowin EDA
impl/
*.fs
*.rpt.html
*.log
project_process_config.json

# OS / editor
.DS_Store
Thumbs.db
*.swp

# Vivado IP repository — copied out of the gitignored hls/ tree so a Vivado
# project can point at a stable path. Regenerate with scripts/export_ip.tcl.
ip_repo/

# LaTeX build artefacts
report/*.aux
report/*.log
report/*.out
report/*.toc
report/*.fls
report/*.fdb_latexmk

# Icarus work dir for the RTL-vs-C check (regenerate: python scripts/tv_to_hex.py)
sim/jepasafe_rtl/
