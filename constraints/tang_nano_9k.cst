// Physical constraints for the Sipeed Tang Nano 9K (Gowin GW1NR-LV9QN88PC6/I5).
//
// Clock, LEDs and buttons below are the standard Tang Nano 9K assignments.
// The MPU6050 and HC-08 pins come from the connection tables in CLAUDE.md —
// VERIFY them against the Sipeed pinout diagram before wiring anything up,
// and note the sensor is 3.3 V only.

// ---------------------------------------------------------------- clock
IO_LOC  "sys_clk" 52;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// ---------------------------------------------------------------- reset (button S1)
IO_LOC  "sys_rst_n" 4;
IO_PORT "sys_rst_n" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// ---------------------------------------------------------------- LEDs (active low)
IO_LOC  "led[0]" 10;
IO_LOC  "led[1]" 11;
IO_LOC  "led[2]" 13;
IO_LOC  "led[3]" 14;
IO_LOC  "led[4]" 15;
IO_LOC  "led[5]" 16;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

// ---------------------------------------------------------------- MPU6050 (I2C)
// Open-drain with pull-ups; the GY-521 breakout carries its own 4.7k pull-ups.
IO_LOC  "mpu_scl" 38;
IO_PORT "mpu_scl" IO_TYPE=LVCMOS33 PULL_MODE=UP OPEN_DRAIN=ON;
IO_LOC  "mpu_sda" 27;
IO_PORT "mpu_sda" IO_TYPE=LVCMOS33 PULL_MODE=UP OPEN_DRAIN=ON;

// ---------------------------------------------------------------- HC-08 (UART)
// ble_tx drives the module's RXD; ble_rx listens to its TXD.
IO_LOC  "ble_tx" 28;
IO_PORT "ble_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "ble_rx" 29;
IO_PORT "ble_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
